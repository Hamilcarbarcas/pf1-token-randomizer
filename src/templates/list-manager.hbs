<div class="token-randomizer-lists">

  {{!-- ═══════════ Name Database ═══════════ --}}
  <div class="settings-section">
    <h3><i class="fas fa-signature"></i> {{localize "TR.Lists.NameDatabase"}}</h3>
    <p class="hint">
      {{localize "TR.Lists.NameDbInfo" count=nameCount given=givenCount surname=surnameCount}}
    </p>
    <p class="hint">
      {{{localize "TR.Lists.ImportHint"}}}
    </p>
    <div class="list-actions">
      <button type="button" class="list-btn" data-action="importNames">
        <i class="fas fa-file-import"></i> {{localize "TR.Lists.ImportNames"}}
      </button>
      <button type="button" class="list-btn" data-action="exportNames" {{#unless hasNames}}disabled{{/unless}}>
        <i class="fas fa-file-export"></i> {{localize "TR.Lists.ExportTsv"}}
      </button>
    </div>
  </div>

  {{!-- ═══════════ Adjective Lists ═══════════ --}}
  <div class="settings-section">
    <h3><i class="fas fa-tags"></i> {{localize "TR.Lists.AdjectiveLists"}}</h3>
    <p class="hint">
      {{{localize "TR.Lists.AdjHint"}}}
    </p>

    {{#if hasAdjLists}}
    <div class="adj-manage-list">
      <div class="adj-manage-header">
        <span class="col-name">{{localize "TR.Lists.ColList"}}</span>
        <span class="col-count">{{localize "TR.Lists.ColWords"}}</span>
        <span class="col-source">{{localize "TR.Lists.ColSource"}}</span>
        <span class="col-actions"></span>
      </div>
      {{#each adjLists}}
      <div class="adj-manage-row">
        <span class="col-name">{{name}}</span>
        <span class="col-count">{{count}}</span>
        <span class="col-source">
          {{#if isBundled}}<span class="src-tag src-bundled">{{localize "TR.Lists.SrcBundled"}}</span>{{/if}}
          {{#if isOverridden}}<span class="src-tag src-overridden">{{localize "TR.Lists.SrcOverridden"}}</span>{{/if}}
          {{#if isCustom}}<span class="src-tag src-custom">{{localize "TR.Lists.SrcCustom"}}</span>{{/if}}
        </span>
        <span class="col-actions">
          <button type="button" class="list-btn small" data-action="replaceAdjList" data-list="{{name}}" title="{{localize "TR.Lists.ReplaceTitle"}}">
            <i class="fas fa-upload"></i> {{localize "TR.Lists.Replace"}}
          </button>
          {{#if isOverridden}}
          <button type="button" class="list-btn small" data-action="deleteAdjList" data-list="{{name}}" title="{{localize "TR.Lists.RevertTitle"}}">
            <i class="fas fa-undo"></i> {{localize "TR.Lists.Revert"}}
          </button>
          {{/if}}
          {{#if isCustom}}
          <button type="button" class="list-btn small list-btn-danger" data-action="deleteAdjList" data-list="{{name}}" title="{{localize "TR.Lists.DeleteTitle"}}">
            <i class="fas fa-trash"></i> {{localize "TR.Lists.Delete"}}
          </button>
          {{/if}}
        </span>
      </div>
      {{/each}}
    </div>
    {{else}}
    <p class="hint">{{localize "TR.Lists.NoAdjLists"}}</p>
    {{/if}}

    <div class="list-actions">
      <button type="button" class="list-btn" data-action="addAdjList">
        <i class="fas fa-plus"></i> {{localize "TR.Lists.AddList"}}
      </button>
    </div>
  </div>

</div>
