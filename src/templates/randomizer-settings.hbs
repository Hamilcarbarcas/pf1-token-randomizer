<div class="token-randomizer-settings">

  {{!-- Tab Bar --}}
  <nav class="randomizer-tabs">
    <button type="button" class="randomizer-tab-btn {{#if (eq activeTab 'ability-scores')}}active{{/if}}" data-action="switchTab" data-tab="ability-scores">
      <i class="fas fa-dice-d20"></i> {{localize "TR.Tab.AbilityScores"}}
    </button>
    <button type="button" class="randomizer-tab-btn {{#if (eq activeTab 'name')}}active{{/if}}" data-action="switchTab" data-tab="name">
      <i class="fas fa-signature"></i> {{localize "TR.Tab.Name"}}
    </button>
    <button type="button" class="randomizer-tab-btn {{#if (eq activeTab 'treasure')}}active{{/if}}" data-action="switchTab" data-tab="treasure">
      <i class="fas fa-coins"></i> {{localize "TR.Tab.Treasure"}}
    </button>
  </nav>

  {{!-- ═══════════ Ability Scores Tab ═══════════ --}}
  {{#if (eq activeTab "ability-scores")}}
  <div class="tab-content">
    <div class="settings-section">
      <div class="setting-row enable-row">
        <label>
          <input type="checkbox" class="randomizer-enabled" {{#if abilityEnabled}}checked{{/if}} />
          <span>{{localize "TR.Ability.EnableRandomization"}}</span>
        </label>
      </div>
      <p class="hint">{{localize "TR.Ability.EnableHint"}}</p>
    </div>

    <div class="settings-section method-section {{#unless abilityEnabled}}disabled{{/unless}}">
      <h3>{{localize "TR.Ability.GenerationMethod"}}</h3>
      <select class="randomizer-method" {{#unless abilityEnabled}}disabled{{/unless}}>
        {{#each methods}}
        <option value="{{key}}" {{#if selected}}selected{{/if}}>{{label}}</option>
        {{/each}}
      </select>
    </div>

    <div class="settings-section constraints-section {{#unless abilityEnabled}}disabled{{/unless}}">
      <h3>{{localize "TR.Ability.Constraints"}}</h3>
      <p class="hint">{{localize "TR.Ability.ConstraintsHint"}}</p>

      <div class="setting-row prioritize-row">
        <label>
          <input type="checkbox" class="prioritize-enabled" {{#if prioritizeEnabled}}checked{{/if}} {{#unless abilityEnabled}}disabled{{/unless}} />
          <span>{{localize "TR.Ability.EnablePriority"}}</span>
        </label>
      </div>
      <p class="hint">{{localize "TR.Ability.PriorityHint"}}</p>

      <p class="hint">{{{localize "TR.Ability.NilHint"}}}</p>

      <div class="constraints-grid">
        <div class="constraint-header">
          <span class="ability-name-header">{{localize "TR.Col.Ability"}}</span>
          <span class="min-header">{{localize "TR.Col.Min"}}</span>
          <span class="max-header">{{localize "TR.Col.Max"}}</span>
          <span class="priority-header {{#unless prioritizeEnabled}}disabled{{/unless}}">{{localize "TR.Col.Priority"}}</span>
          <span class="nil-header">{{localize "TR.Col.Nil"}}</span>
        </div>
        {{#each abilities}}
        <div class="constraint-row">
          <span class="ability-name">{{name}}</span>
          <input type="number" class="ability-min" data-ability="{{key}}" value="{{min}}" min="0" max="18" {{#if nil}}disabled{{/if}} {{#unless ../abilityEnabled}}disabled{{/unless}} />
          <input type="number" class="ability-max" data-ability="{{key}}" value="{{max}}" min="0" max="25" {{#if nil}}disabled{{/if}} {{#unless ../abilityEnabled}}disabled{{/unless}} />
          <input type="number" class="ability-priority {{#unless ../prioritizeEnabled}}disabled{{/unless}}" data-ability="{{key}}" value="{{#if ../prioritizeEnabled}}{{priority}}{{/if}}" min="0" max="6" placeholder="-" {{#if nil}}disabled{{/if}} {{#unless ../prioritizeEnabled}}disabled{{/unless}} />
          <input type="checkbox" class="ability-nil" data-ability="{{key}}" {{#if nil}}checked{{/if}} {{#unless ../abilityEnabled}}disabled{{/unless}} />
        </div>
        {{/each}}
      </div>
    </div>
  </div>
  {{/if}}

  {{!-- ═══════════ Name Tab ═══════════ --}}
  {{#if (eq activeTab "name")}}
  <div class="tab-content">
    <div class="settings-section">
      <div class="setting-row enable-row">
        <label>
          <input type="checkbox" class="name-enabled" {{#if nameEnabled}}checked{{/if}} />
          <span>{{localize "TR.Name.EnableRandomization"}}</span>
        </label>
      </div>
      <p class="hint">{{localize "TR.Name.EnableHint"}}</p>
    </div>

    <div class="settings-section name-builder-section {{#unless nameEnabled}}disabled{{/unless}}">
      <h3>{{localize "TR.Name.Builder"}}</h3>
      <p class="hint">{{localize "TR.Name.BuilderHint"}}</p>

      {{!-- Live preview --}}
      <div class="name-preview-row">
        <span class="name-preview-label">{{localize "TR.Name.Sample"}}</span>
        <span class="name-preview-value">{{#if namePreview}}{{namePreview}}{{else}}<em>{{localize "TR.Empty"}}</em>{{/if}}</span>
        <button type="button" class="name-preview-reroll" data-action="rerollPreview" title="{{localize "TR.Name.RerollTitle"}}">
          <i class="fas fa-dice"></i>
        </button>
      </div>
      {{#if obscureFeatureEnabled}}
      <div class="name-preview-row obscured-preview-row">
        <span class="name-preview-label">{{localize "TR.Name.ObscuredSample"}}</span>
        <span class="obscured-preview-value">{{#if obscuredPreview}}{{obscuredPreview}}{{else}}<em>{{localize "TR.Empty"}}</em>{{/if}}</span>
      </div>
      {{/if}}

      {{!-- Name components (ordered, collapsible) --}}
      <div class="name-components-box">
        <div class="components-box-header">
          <span class="components-box-title">{{localize "TR.Name.Components"}}</span>
          {{#if nameSegments.length}}
          <button type="button" class="components-clear-btn" data-action="clearSegments" title="{{localize "TR.Name.ClearTitle"}}">
            <i class="fas fa-trash"></i> {{localize "TR.Name.Clear"}}
          </button>
          {{/if}}
        </div>
        <div class="name-segments">
        {{#each nameSegments}}
        <div class="name-segment {{#if collapsed}}collapsed{{/if}} {{#unless hasBody}}no-body{{/unless}}">
          <div class="segment-header" {{#if hasBody}}data-action="toggleSegment" data-segment="{{index}}" title="Click to collapse / expand"{{/if}}>
            <span class="segment-title">
              {{#if hasBody}}<i class="fas fa-chevron-down segment-collapse-indicator"></i>{{/if}}
              {{#if isDatabase}}<i class="fas fa-signature"></i> {{localize "TR.Segment.RosterName"}}{{/if}}
              {{#if isAdjective}}<i class="fas fa-tags"></i> {{localize "TR.Segment.Adjective"}}{{/if}}
              {{#if isStatic}}<i class="fas fa-font"></i> {{localize "TR.Segment.StaticText"}}{{/if}}
              {{#if isActor}}<i class="fas fa-user"></i> {{localize "TR.Segment.ActorName"}}{{/if}}
            </span>
            <div class="segment-controls">
              <button type="button" class="segment-btn" data-action="moveSegmentUp" data-segment="{{index}}" title="{{localize "TR.Segment.MoveUp"}}" {{#if isFirst}}disabled{{/if}}><i class="fas fa-chevron-up"></i></button>
              <button type="button" class="segment-btn" data-action="moveSegmentDown" data-segment="{{index}}" title="{{localize "TR.Segment.MoveDown"}}" {{#if isLast}}disabled{{/if}}><i class="fas fa-chevron-down"></i></button>
              <button type="button" class="segment-btn segment-btn-danger" data-action="removeSegment" data-segment="{{index}}" title="{{localize "TR.Segment.Remove"}}"><i class="fas fa-trash"></i></button>
            </div>
          </div>
          {{#if hasBody}}
          <div class="segment-body">

            {{#if isDatabase}}
            <div class="segment-field">
              <label>{{localize "TR.Segment.NameType"}}</label>
              <select class="segment-nametype" data-segment="{{index}}">
                {{#each nameTypeOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
              </select>
            </div>
            <div class="filter-list">
              <div class="filter-list-header">
                <span>{{localize "TR.Filter.Race"}}</span><span>{{localize "TR.Filter.Region"}}</span><span>{{localize "TR.Filter.Gender"}}</span><span>{{localize "TR.Filter.Weight"}}</span><span></span>
              </div>
              {{#each filters}}
              <div class="filter-entry">
                <select class="filter-race" data-segment="{{../index}}" data-filter="{{index}}">
                  {{#each raceOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
                </select>
                <select class="filter-region" data-segment="{{../index}}" data-filter="{{index}}">
                  {{#each regionOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
                </select>
                <select class="filter-gender" data-segment="{{../index}}" data-filter="{{index}}">
                  {{#each genderOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
                </select>
                <div class="weight-group">
                  <input type="range" class="filter-weight" data-segment="{{../index}}" data-filter="{{index}}" min="1" max="10" value="{{weight}}" />
                  <span class="weight-value">{{weight}}</span>
                </div>
                <button type="button" class="filter-delete" data-action="removeFilter" data-segment="{{../index}}" data-filter="{{index}}" title="{{localize "TR.Filter.Remove"}}"><i class="fas fa-times"></i></button>
              </div>
              {{/each}}
              <button type="button" class="filter-add" data-action="addFilter" data-segment="{{index}}"><i class="fas fa-plus"></i> {{localize "TR.Filter.Add"}}</button>
            </div>
            {{/if}}

            {{#if isAdjective}}
            {{#if noLists}}
            <p class="hint">{{{localize "TR.Adj.NoLists"}}}</p>
            {{else}}
            <p class="hint">{{localize "TR.Adj.Hint"}}</p>
            <div class="adj-list">
              {{#each lists}}
              <div class="adj-entry {{#unless enabled}}disabled-weight{{/unless}}">
                <label class="adj-toggle">
                  <input type="checkbox" class="adj-enabled" data-segment="{{../index}}" data-list="{{name}}" {{#if enabled}}checked{{/if}} />
                  <span>{{name}}</span>
                </label>
                <div class="weight-group">
                  <input type="range" class="adj-weight" data-segment="{{../index}}" data-list="{{name}}" min="1" max="10" value="{{weight}}" {{#unless enabled}}disabled{{/unless}} />
                  <span class="weight-value">{{weight}}</span>
                </div>
              </div>
              {{/each}}
            </div>
            {{/if}}
            {{/if}}

            {{#if isStatic}}
            <div class="segment-field">
              <label>{{localize "TR.Static.Text"}}</label>
              <input type="text" class="segment-static-text" data-segment="{{index}}" value="{{text}}" placeholder="{{localize "TR.Static.Placeholder"}}" />
            </div>
            {{/if}}

            {{#if obscureEnabled}}
            <div class="segment-field segment-obscure">
              <label>{{localize "TR.Obscure.Label"}}</label>
              <select class="segment-obscure-mode" data-segment="{{index}}">
                {{#each obscureOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
              </select>
            </div>
            <p class="hint">{{{localize "TR.Obscure.Hint"}}}</p>
            {{#if showObscuredText}}
            <div class="segment-field segment-obscure-alt">
              <label>{{localize "TR.Obscure.AltLabel"}}</label>
              <input type="text" class="segment-obscured-text" data-segment="{{index}}" value="{{obscuredText}}" placeholder="{{localize "TR.Obscure.AltPlaceholder"}}" />
            </div>
            <p class="hint">{{localize "TR.Obscure.AltHint"}}</p>
            {{/if}}
            {{/if}}

          </div>
          {{/if}}
        </div>
        {{else}}
        <p class="hint no-segments-hint">{{localize "TR.Name.NoComponents"}}</p>
        {{/each}}
        </div>

        {{!-- Add a component (type chosen at add-time) --}}
        <div class="segment-add-row">
          <span class="segment-add-label">{{localize "TR.Name.AddComponent"}}</span>
          <button type="button" class="segment-add-btn" data-action="addSegment" data-type="database"><strong class="add-plus">+</strong> <i class="fas fa-signature"></i> {{localize "TR.Segment.RosterName"}}</button>
          <button type="button" class="segment-add-btn" data-action="addSegment" data-type="adjective"><strong class="add-plus">+</strong> <i class="fas fa-tags"></i> {{localize "TR.Segment.Adjective"}}</button>
          <button type="button" class="segment-add-btn" data-action="addSegment" data-type="actor"><strong class="add-plus">+</strong> <i class="fas fa-user"></i> {{localize "TR.Segment.ActorName"}}</button>
          <button type="button" class="segment-add-btn" data-action="addSegment" data-type="static"><strong class="add-plus">+</strong> <i class="fas fa-font"></i> {{localize "TR.Segment.Static"}}</button>
        </div>
      </div>
    </div>

    <div class="settings-section name-database-section">
      <p class="hint">{{{localize "TR.Name.DbInfo" count=nameCount given=givenCount surname=surnameCount}}}</p>
    </div>
  </div>
  {{/if}}

  {{!-- ═══════════ Treasure Tab ═══════════ --}}
  {{#if (eq activeTab "treasure")}}
  <div class="tab-content">
    <div class="settings-section">
      <div class="setting-row enable-row">
        <label>
          <input type="checkbox" class="treasure-enabled" {{#if treasureEnabled}}checked{{/if}} />
          <span>{{localize "TR.Treasure.EnableRandomization"}}</span>
        </label>
      </div>
      <p class="hint">{{{localize "TR.Treasure.EnableHint"}}}</p>
    </div>

    <div class="settings-section treasure-value-section {{#unless treasureEnabled}}disabled{{/unless}}">
      <h3>{{localize "TR.Treasure.TotalValue"}}</h3>
      <p class="hint">{{{localize "TR.Treasure.TotalValueHint"}}}</p>
      <input type="text" class="treasure-gold-formula" value="{{treasureGoldFormula}}" placeholder="{{localize "TR.Treasure.FormulaPlaceholder"}}" {{#unless treasureEnabled}}disabled{{/unless}} />
    </div>

    <div class="settings-section treasure-dist-section {{#unless treasureEnabled}}disabled{{/unless}}">
      <h3>{{localize "TR.Treasure.CoinDistribution"}}</h3>
      <p class="hint">{{{localize "TR.Treasure.CoinDistributionHint"}}}</p>

      <div class="setting-row prioritize-row">
        <label>
          <input type="checkbox" class="treasure-randomize-distribution" {{#if treasureRandomizeDistribution}}checked{{/if}} {{#unless treasureEnabled}}disabled{{/unless}} />
          <span>{{localize "TR.Treasure.RandomizeDistribution"}}</span>
        </label>
      </div>
      <p class="hint">{{#if treasureRandomizeDistribution}}{{localize "TR.Treasure.RandomizeHintOn"}}{{else}}{{localize "TR.Treasure.RandomizeHintOff"}}{{/if}}</p>

      <div class="constraints-grid">
        {{#if treasureRandomizeDistribution}}
        <div class="constraint-header treasure-header-minmax">
          <span class="ability-name-header">{{localize "TR.Col.Coin"}}</span>
          <span class="min-header">{{localize "TR.Col.Min"}}</span>
          <span class="max-header">{{localize "TR.Col.Max"}}</span>
        </div>
        {{#each coins}}
        <div class="constraint-row treasure-row-minmax">
          <span class="ability-name">{{name}}</span>
          <input type="number" class="treasure-min" data-coin="{{key}}" value="{{min}}" min="0" max="100" {{#unless ../treasureEnabled}}disabled{{/unless}} />
          <input type="number" class="treasure-max" data-coin="{{key}}" value="{{max}}" min="0" max="100" {{#unless ../treasureEnabled}}disabled{{/unless}} />
        </div>
        {{/each}}
        {{else}}
        <div class="constraint-header treasure-header-pct">
          <span class="ability-name-header">{{localize "TR.Col.Coin"}}</span>
          <span class="pct-header">{{localize "TR.Col.Percent"}}</span>
        </div>
        {{#each coins}}
        <div class="constraint-row treasure-row-pct">
          <span class="ability-name">{{name}}</span>
          <input type="number" class="treasure-pct" data-coin="{{key}}" value="{{pct}}" min="0" {{#unless ../treasureEnabled}}disabled{{/unless}} />
        </div>
        {{/each}}
        {{/if}}
      </div>
    </div>
  </div>
  {{/if}}

  {{!-- ═══════════ Shared Actions ═══════════ --}}
  <div class="settings-actions">
    {{#unless isDefaults}}
    <button type="button" class="reset-defaults-btn" data-action="reset" title="{{localize "TR.Action.ResetTitle"}}">
      <i class="fas fa-undo"></i> {{localize "TR.Action.Reset"}}
    </button>
    {{/unless}}
    <div class="action-buttons">
      <button type="button" class="settings-cancel-btn" data-action="cancel">{{localize "TR.Action.Cancel"}}</button>
      <button type="button" class="settings-ok-btn" data-action="save">{{localize "TR.Action.Save"}}</button>
    </div>
  </div>
</div>
