<div class="token-randomizer-stat-methods">
  <div class="settings-section">
    <h3>{{localize "TR.StatMethods.Title"}}</h3>
    <p class="hint">{{{localize "TR.StatMethods.Intro"}}}</p>
    <ul class="method-help hint">
      <li>{{{localize "TR.StatMethods.ArrayHelp"}}}</li>
      <li>{{{localize "TR.StatMethods.FormulaHelp"}}}</li>
    </ul>

    <div class="stat-method-list">
      {{#each methods}}
      <div class="stat-method-row {{typeClass}}" data-index="{{index}}">
        <div class="stat-method-head">
          <span class="stat-method-type">
            {{#if isFormula}}<i class="fas fa-dice"></i> {{localize "TR.StatMethods.TypeFormula"}}{{else}}<i class="fas fa-dice-d6"></i> {{localize "TR.StatMethods.TypeArray"}}{{/if}}
          </span>
          <input type="text" class="stat-method-label" data-index="{{index}}" value="{{label}}" placeholder="{{localize "TR.StatMethods.LabelPlaceholder"}}" />
          <button type="button" class="stat-method-delete" data-action="removeMethod" data-index="{{index}}" title="{{localize "TR.StatMethods.DeleteTitle"}}"><i class="fas fa-trash"></i></button>
        </div>

        {{#if isFormula}}
        <div class="stat-method-formula-row">
          <input type="text" class="stat-method-formula" data-index="{{index}}" value="{{formula}}" placeholder="{{localize "TR.StatMethods.FormulaPlaceholder"}}" />
        </div>
        {{else}}
        <div class="stat-method-values">
          {{#each values}}
          <input type="number" class="stat-method-value" data-method="{{../index}}" data-slot="{{@index}}" value="{{this}}" min="1" max="30" />
          {{/each}}
        </div>
        {{/if}}
      </div>
      {{else}}
      <p class="hint no-methods-hint">{{localize "TR.StatMethods.NoMethods"}}</p>
      {{/each}}
    </div>

    <div class="stat-method-add-row">
      <span class="segment-add-label">{{localize "TR.StatMethods.AddMethod"}}</span>
      <button type="button" class="segment-add-btn" data-action="addMethod" data-type="array"><strong class="add-plus">+</strong> <i class="fas fa-dice-d6"></i> {{localize "TR.StatMethods.TypeArray"}}</button>
      <button type="button" class="segment-add-btn" data-action="addMethod" data-type="formula"><strong class="add-plus">+</strong> <i class="fas fa-dice"></i> {{localize "TR.StatMethods.TypeFormula"}}</button>
    </div>
  </div>

  <div class="settings-actions">
    <div class="action-buttons">
      <button type="button" class="settings-cancel-btn" data-action="cancel">{{localize "TR.Action.Cancel"}}</button>
      <button type="button" class="settings-ok-btn" data-action="save">{{localize "TR.Action.Save"}}</button>
    </div>
  </div>
</div>
